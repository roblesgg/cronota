{
  "name": "imputa-me",
  "version": "2.14.5",
  "description": "Cronota — registra y consulta tus horas por tarea",
  "main": "main.js",
  "author": "DripDev",
  "scripts": {
    "start": "electron .",
    "check": "node tools/check-all.js",
    "store": "electron-builder --win appx --publish never"
  },
  "dependencies": {
    "koffi": "^2.16.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jimp": "^0.22.12",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "me.imputa.app",
    "productName": "imputa.me",
    "files": [
      "main.js",
      "themes.js",
      "palettes.js",
      "capturas-windows.js",
      "copias.js",
      "nube.js",
      "outlook-ics.js",
      "en-llamada.js",
      "recortar-solapes.js",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "appx"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "afterPack": "build-hooks/afterPack.js",
    "asarUnpack": [
      "node_modules/koffi/build/koffi/win32_x64/**"
    ],
    "appx": {
      "identityName": "lvaroRoblesGonzlezDripDev.Cronota",
      "publisher": "CN=5FC043BE-23BD-4F4B-BCAA-EB64CDF0A6B1",
      "publisherDisplayName": "Álvaro Robles González (DripDev)",
      "applicationId": "imputame",
      "displayName": "Cronota",
      "backgroundColor": "transparent",
      "showNameOnTiles": false,
      "languages": [
        "es-ES"
      ],
      "addAutoLaunchExtension": true,
      "artifactName": "cronota-store.${ext}"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "koffi@2.16.3": true
  }
}
