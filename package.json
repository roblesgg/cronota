{
  "name": "imputa-me",
  "version": "2.9.1",
  "description": "Cronota — registra y consulta tus horas por tarea",
  "main": "main.js",
  "author": "DripDev",
  "scripts": {
    "start": "electron .",
    "check": "node tools/check-all.js",
    "dist": "electron-builder --win --publish never",
    "store": "electron-builder --win appx --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "electron-updater": "^6.8.9",
    "koffi": "^2.16.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jimp": "^0.22.12",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "me.imputa.app",
    "productName": "imputa.me",
    "files": [
      "main.js",
      "sync.js",
      "themes.js",
      "palettes.js",
      "desenfoque-windows.js",
      "capturas-windows.js",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "roblesgg",
        "repo": "cronota"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "afterPack": "build-hooks/afterPack.js",
    "portable": {
      "artifactName": "cronota-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Cronota",
      "uninstallDisplayName": "Cronota",
      "artifactName": "cronota-setup.exe",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "asarUnpack": [
      "node_modules/koffi/build/koffi/win32_x64/**"
    ],
    "appx": {
      "identityName": "lvaroRoblesGonzlezDripDev.Cronota",
      "publisher": "CN=5FC043BE-23BD-4F4B-BCAA-EB64CDF0A6B1",
      "publisherDisplayName": "Álvaro Robles González (DripDev)",
      "applicationId": "imputame",
      "displayName": "Cronota",
      "backgroundColor": "transparent",
      "showNameOnTiles": false,
      "languages": [
        "es-ES"
      ],
      "addAutoLaunchExtension": false,
      "artifactName": "cronota-store.${ext}"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "koffi@2.16.3": true
  }
}
